  "records": {
    "description": "Combines two boxes of the same item type into one bigger box.",
    "features": [
      "Can handle full boxes.",
      "Uses 3 hoppers per slice.",
      "Has a footprint of 8x5.",
      "Requires no containers to be filled during construction."
    ],
    "instructions": [
      "Use an external pair comparer in order to speed up merging",
      "Don't input boxes at too close intervals (a normal whitelisting temp is plenty slow enough)",
      "Needs a fill level sorter to sort out the output."
    ],
    "notes": "Expanding it to more than 4 slices requires a stream using magma blocks. Watch Jayroi's video on mergers to understand how it works.",
    "compatibility": "1.19+ due to water stream changes"
  },
